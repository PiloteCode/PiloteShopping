# =============================================================================
# Pilote Shopping CMS — Variables d'environnement
# =============================================================================
# Copier ce fichier vers .env et renseigner les valeurs réelles.
# Le fichier .env NE DOIT JAMAIS être committé.
# =============================================================================

# --- Environnement ---
APP_ENV=production
# production | staging | development
# En production: DEBUG_MODE=false et display_errors=0 forcés

# --- Site ---
SITE_NAME="Pilote Shopping"
SITE_URL=https://piloteshopping.com
SITE_EMAIL=support@piloteshopping.com
ADMIN_EMAIL=admin@piloteshopping.com

# --- Base de données ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=piloteshopping
DB_USER=piloteshopping
DB_PASS=CHANGE_ME_GENERATE_NEW_PASSWORD
DB_CHARSET=utf8mb4

# --- Sécurité (générer des valeurs uniques de >=64 caractères avec random_bytes) ---
# JWT_SECRET: clé HMAC pour les JWT. ATTENTION: une seule valeur utilisée partout.
JWT_SECRET=CHANGE_ME_GENERATE_SECRET_BASE64
# ENCRYPTION_KEY: clé symétrique pour chiffrement applicatif (32 octets hex)
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_HEX
# HASH_SALT: poivre global utilisé en complément du sel bcrypt
HASH_SALT=CHANGE_ME_RANDOM_32_CHARS

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare Turnstile (captcha) ---
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_ENABLED=true

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM=no-reply@piloteshopping.com
SMTP_FROM_NAME="Pilote Shopping"

# --- DKIM ---
DKIM_SELECTOR=default
# Chemin LOCAL vers la clé privée DKIM (hors webroot, perms 0600)
DKIM_PRIVATE_KEY_PATH=/etc/dkim/piloteshopping.private.key

# --- Cron sécurisé ---
# Secret partagé pour exécuter les crons via HTTP (header X-Cron-Secret)
CRON_SECRET=CHANGE_ME_RANDOM_64_CHARS

# --- Discord webhook (notifications internes) ---
DISCORD_BLOG_WEBHOOK=

# --- Reverse-proxy / WAF ---
# Liste CSV des CIDR à qui faire confiance pour X-Forwarded-For, vide = pas de confiance
TRUSTED_PROXIES=

# --- Taxes ---
TAX_RATE=0.064

# --- Email queue ---
EMAIL_BATCH_SIZE=50
EMAIL_MAX_EXECUTION_TIME=290
EMAIL_SLEEP_INTERVAL=1
EMAIL_HOURLY_LIMIT=1000
EMAIL_DAILY_LIMIT=20000
EMAIL_MAX_RETRIES=3
EMAIL_LOGGING_ENABLED=true
EMAIL_LOG_LEVEL=warning
