# ── Pilote Shopping v2 — environment template ──
# Copy to .env and fill in. Local dev works with all defaults below.

# Database. Empty => embedded PGlite Postgres (zero-install, great for dev/CI).
# Production: a real Postgres connection string.
DATABASE_URL=
PGLITE_PATH=.pglite

SITE_URL=http://localhost:3000
SITE_NAME=Pilote Shopping

AUTH_SECRET=change-me
SESSION_COOKIE=pilote_session
CSRF_COOKIE=pilote_csrf

# Simulate payments/emails locally. Set false + provide Stripe keys for live.
DEMO_MODE=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

SEED_ADMIN_EMAIL=admin@piloteshopping.com
SEED_ADMIN_PASSWORD=Admin1234!
SEED_USER_EMAIL=demo@piloteshopping.com
SEED_USER_PASSWORD=Demo1234!
